#!/data/data/com.termux/files/usr/bin/bash
cd ~/downloads||printf 'Proceeding, even though ~/downloads not found...\n' >&2
function a {
if command -v "$1"
then
	M[${#M[*]}]="${3:-$1}"
	M[${#M[*]}]="${2:-$1}"
fi
}
a w3m 'w3m pager/browser'
if [[ $0 =~ -file-editor$ ]]; then
	T='file'
	TN=name
	a pager "default pager [$(realpath "$(command -v pager)")]"
	a editor "default editor [$(realpath "$(command -v editor)")]"
	a sensible-editor
	a nano Nano
	a ne 'The Nice Editor'
	a mcedit 'Midnight Commander editor'
        a micro 'Light emacs style editor'
	a nvim Neovim
	a vim 'Vi iMproved'
	a vi 'Viewer/Editor'
	a sensible-pager
	a more 'more viewer'
	a less 'less viewer'
	a prj 'add to project' 'proj file ""'
	a termux-share 'edit in app' 'termux-share -a edit'
	a termux-share 'send to app' 'termux-share -a send'
	a termux-share 'view in app'
elif [[ $0 =~ -url-opener$ ]]; then
	T=url
	a www-browser "default browser [$(realpath "$(command -v www-browser)")]"
	a sensible-browser
	a elinks
	a lynx
	a prj bookmark 'proj url ""'
	if [[ $1 =~ ^(ht|f)tp: ]] || ! [[ "$(wget 2>&1)" =~ ^BusyBox ]]
	then
		a wget 'download with wget'
	fi
	a curl 'download with curl' 'curl -O'
	a termux-open-url 'view in app'
else
	T=unknown
fi
a termux-clipboard-set "copy $T$TN to clipboard"
a termux-share "share $T$TN as text" 'termux-share -a send <<<'
a termux-open 'view in app' 'termux-open --chooser'
a termux-open 'send to app' 'termux-open --send --chooser'
if cmd=$(dialog --title "Select Action" --menu "What to do with $T $1" 0 0 0 "${M[@]}" echo test 2>&1 >/dev/tty)
then
	printf -v cmd '%s %q' "$cmd" "$1"
	eval "$cmd"
else
	printf 'Dialog error %i\n' $?
fi

